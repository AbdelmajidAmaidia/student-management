pipeline {

    agent any


    parameters {

        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag generated by CI'
        )

    }


    environment {

        IMAGE_NAME = 'amaidiaabdelmajiddo/student-management'

    }


    options {

        timeout(time: 15, unit: 'MINUTES')

        timestamps()

        disableConcurrentBuilds()

    }



    stages {


        stage('Update Kubernetes Manifest') {


            steps {

                sh """

                echo "===================================="

                echo "Updating Kubernetes image"

                echo "New image: ${IMAGE_NAME}:${IMAGE_TAG}"

                echo "===================================="



                echo "Before modification:"

                grep image k8s/app/deployment.yaml || true



                sed -i \
                "s#image:.*#image: ${IMAGE_NAME}:${IMAGE_TAG}#" \
                k8s/deployment.yaml



                echo "After modification:"

                grep image k8s/app/deployment.yaml || true


                """

            }

        }





        stage('Commit Kubernetes Change') {


            steps {


                sh """

                git config user.name "Jenkins"

                git config user.email "jenkins@company.com"



                git add k8s/app/deployment.yaml



                git diff --cached --quiet || git commit \
                -m "Deploy ${IMAGE_NAME}:${IMAGE_TAG}"


                """

            }

        }





        stage('Push Git Changes') {


            steps {


                withCredentials([

                    gitUsernamePassword(

                        credentialsId: 'github-token',

                        gitToolName: 'Default'

                    )

                ]) {


                    sh """

                    git push origin main

                    """

                }

            }

        }


    }





    post {


        success {


            echo """

            ====================================

            ✅ CD SUCCESS

            Image updated:

            ${IMAGE_NAME}:${IMAGE_TAG}


            ArgoCD will synchronize Kubernetes

            ====================================

            """

        }




        failure {


            echo """

            ====================================

            ❌ CD FAILED

            Kubernetes manifest not updated

            ====================================

            """

        }



        always {

            cleanWs()

        }


    }


}
