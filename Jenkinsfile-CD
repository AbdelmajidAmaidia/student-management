pipeline {

    agent any


    parameters {

        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag generated by CI'
        )

    }


    environment {

        IMAGE_NAME = 'amaidiaabdelmajiddo/student-management'

    }


    options {

        timeout(time: 15, unit: 'MINUTES')

        timestamps()

        disableConcurrentBuilds()

    }



    stages {


        stage('Update Kubernetes Manifest') {

            steps {

                sh """

                echo "===================================="
                echo "Updating Kubernetes image"
                echo "Image: ${IMAGE_NAME}:${IMAGE_TAG}"
                echo "===================================="


                echo "Current image:"
                grep image k8s/app/deployment.yaml || true



                echo "Updating image tag..."


                sed -i \
                "s#image:.*#image: ${IMAGE_NAME}:${IMAGE_TAG}#" \
                k8s/app/deployment.yaml



                echo "Updated image:"
                grep image k8s/app/deployment.yaml || true


                """

            }

        }





        stage('Commit Kubernetes Change') {

            steps {

                sh """

                git config user.name "Jenkins"

                git config user.email "jenkins@company.com"



                git add k8s/app/deployment.yaml



                if git diff --cached --quiet; then

                    echo "No Kubernetes change detected"

                else

                    git commit \
                    -m "Deploy ${IMAGE_NAME}:${IMAGE_TAG}"

                fi


                """

            }

        }





        stage('Push Git Changes') {

            steps {


                withCredentials([

                    gitUsernamePassword(

                        credentialsId: 'github-token',

                        gitToolName: 'Default'

                    )

                ]) {


                    sh """

                    git push origin main

                    """

                }

            }

        }



    }





    post {


        success {

            echo """

            ====================================

            ✅ CD SUCCESS

            Image deployed:

            ${IMAGE_NAME}:${IMAGE_TAG}


            GitOps repository updated

            ArgoCD will synchronize automatically

            ====================================

            """

        }




        failure {

            echo """

            ====================================

            ❌ CD FAILED

            Kubernetes manifest update failed


            ====================================

            """

        }



        always {

            cleanWs()

        }


    }


}
